# Model and training settings
EMBEDDINGS_COUNT=10
EPOCH_COUNT=100

# Synonym search settings
SYNONYM_WORD=война
SYNONYM_EMBEDDINGS_NAME=embeddings
SYNONYM_EPOCH=1

# true: initialize random embeddings; false: continue from the files below
TRAIN_FROM_SCRATCH=true
CONTINUE_INPUT_EMBEDDINGS=embeddings/embeddings_in_90.txt
CONTINUE_OUTPUT_EMBEDDINGS=embeddings/embeddings_out_90.txt
CONTINUE_OUTPUT_NAME=embeddings_finetuned
